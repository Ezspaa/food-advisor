# Copy this file to .env and change the values for your machine.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_advisor
# How long a login stays valid (days)
SESSION_DAYS=7

# ---- Cloud hosting (optional) ----
# One URL instead of DB_HOST/DB_USER/...:  DATABASE_URL=mysql://user:pass@host:3306/dbname
# DB_SSL=true            managed MySQL that requires TLS
# TRUST_PROXY=1          when running behind the host's proxy (Railway, Render…)
# DEMO_PASSWORD=...      password for the sample accounts — change it on a public server!
